! main game function;
! sprig ; arcade ; high seas ; bin ; Summer of Making ; low skies ; boba ; blot ; cider ; onboard ; counterspell ; scrapyard ; daydream ; shipwrecked ; blot ; easel
! arcade ; high seas ; bin ; som ; low skies ; boba/hackaccino/;juice ; SLACKOPOLYPSE
Include "parser";
Include "verbLib";

Object SprigRoom "~Sprig Room~"
    with description "The room is full with colorful squares floating around. Every once in a while, you hear a bell ring from the distance. To your left you can see square, plastic, light grey keycaps. Discarded before you on the floor is a green printed circuit board. In the corner of the room, an unevenly made trashcan leans against the scratched up wall. Behind you, a door leads into another room.",
    name "Room" "first room",
    initial "^^^Now, you have found a lead to where the devious hackers have hid. However, there are several rooms that you must traverse in order to get to murdering the hackers. Remember, SACRIFICES MUST BE MADE!!!<ÖT [like we have to sacrifice the evil hackers]",
    s_to SprigDoor,
    has light,
;
Object -> SprigDoor "Door"
    with door_to PicoRoom,
    door_dir s_to,
    description "A door with a few Orpheus stickers on it. One of them has you on it as well :3c",
    name "door" "pico door",
    has scenery static door openable,

;
Object -> Sprig "PCB"
    with name "pcb" "sprig" "green pcb" "game console",
    description "A green PCB with a small screen and eight buttons on one side; the Hack Club flag is printed onto it in white. The other side has a slot for a battery and some strange holes--almost as though something were missing...",
    invent "A strangely incomplete green PCB",
    describe true,
    has edible supporter,
    with after [;
        Receive: if (noun == OrpheusPico) print "The screen turns on. You have won the game! This will be finished another time :3c";
        Take: "You pick up the PCB. It pokes your finger a bit; you quickly hold it in a less spiky place.";
        Drop: "It drops to the ground, making a disturbing noise. Examining it, it seems to still be as functional as it was beforehand.";
    ],
    before [;
        Eat: "You love eating PCBs... however, this is not a functional one. Functional ones taste better.";
    ]
;
Object -> Trashcan "Trashcan"
    with description "A true work of art, leaning against the wall.",
    name "bin" "trash can" "trashcan" "trash bin" "trashbin",
    describe true,
    before [;
        Eat: "You prefer the taste of trash.";
        Take: "No.";
    ],
    after [;
        
    ],
    has static container open,
;
Object Trash "Trash" Trashcan
    with description "Beautiful, amazing, lovely, trash.",
    name "trash" "trashhh" "heidi's dinner",
    describe true,
    before [;
        Drop: "You will never let go of this lovely piece of trash.";
    ],
    after [;
        Eat: "It tastes like trash--that is, amazing.";
        Take: "Your heartbeat speeds up in anticipation of the taste.";
    ],
    has edible
;
Object PicoRoom "Orpheus Pico Room"
    with description "A small, cupboard-esque room where schematics and circuit boards litter the shelves. You feel yourself pulled toward one shelf in particular...",
    name "room" "pico room",
    has light,
    with n_to PicoDoor
;
Object -> Shelf "shelf"
    with description "A shelf with a small electronic-looking thingy on it.",
    describe true,
    name "shelf" "pico holder" "i hate my life uwu",
    has supporter
;
Object ->-> OrpheusPico "Orpheus Pico"
    with description "A small thingy that does electronics stuff. It has a beautiful dinosaur on it.",
    name "pico" "orph pico" "microcontroller" "orpheus pico" "chip" "thingy that does electronics stuff" "electronics thingy" "shelf",
    describe true,
    before [;
        Eat: "You would never desecrate Orpheus merch in that way... it does look really good though.";
        Drop: "That could break the pico!";
    ],
    after [;
        Take: "What a beautiful electronics thingy @@64";
    ],
    n_to PicoDoor
;
Object -> PicoDoor "door"
    with door_to SprigRoom,
    door_dir n_to,
    description "A door with a few Orpheus stickers on it. One of them has you on it as well :3c",
    name "door" "sprig door",
    has scenery static door open,
;

!
! Sprig(); i don't think this is how it works lmAo


[Intro;
    print "You are Heidi Hakkuun, a racoon who works for Hack Club.^You have mediocre intelligence and an immense love for making really amazing hardware projects.^";
    print "Also, you are dating a dinosaur.^";
    print "However, an association of obnoxius Hack Clubbers have recently launched an extremely evil plan: to murder Orpheus, the aforementioned dinosaur.^";
    print "There is only one way to save Orpheus; you must murder the Hack Clubbers involved.^";
    print "Technically, this goes against your job [being Hack Club staff], but some sacrifices must be made.^^";
];


[Initialise;
    print "DISCLAIMER PLEASE DON'T MURDER PEOPLE /GEN^";
    Intro();
    location = SprigRoom;
];
[ XyzzySub; "Nothing happens."; ];
Verb 'xyzzy' * -> Xyzzy;
Include "grammar";